{:paths ["site-dsl/src" "scripts" "src"]
 :deps  {org.clojure/clojurescript {:mvn/version "1.11.132"}
         http-kit/http-kit        {:mvn/version "2.8.0"}
         babashka/fs              {:mvn/version "0.5.20"}
         hiccup/hiccup           {:mvn/version "1.0.5"}
         markdown-clj/markdown-clj {:mvn/version "1.11.4"}
         ;; 🧪 Clojure Spec for Aspiringly-Sacred Standards
         org.clojure/spec.alpha   {:mvn/version "0.3.218"}
         org.clojure/test.check   {:mvn/version "1.1.1"}}
 :tasks
 { :requires ([babashka.fs :as fs]
              [babashka.process :refer [shell]]
              [clojure.string :as str]
              [hiccup.core :as h]
              [markdown.core :as md])

  doctor {:doc "Check toolchain availability for aspiringly-sacred technology development"
          :task (do (println "🌙 Aspiringly-Sacred Technology Toolchain Status")
                    (println "bb version:" (System/getProperty "babashka.version"))
                    (shell "bash" "-lc" "node --version || echo 'Node.js not found'")
                    (shell "bash" "-lc" "clojure -Sdescribe | head -n 3 || echo 'Clojure not found'")
                    (shell "bash" "-lc" "npx vite --version || echo 'Vite not found'")
                    (shell "bash" "-lc" "clj-kondo --version || echo 'clj-kondo not found'")
                    (shell "bash" "-lc" "zprint --version || echo 'zprint not found'"))}

  epub:generate {:doc "Generate aspiringly-sacred technology epub for contemplative reading"
                 :task (do (println "📚 Generating Aspiringly-Sacred Technology Epub...")
                           (let [teachings (gather-sacred-teachings)]
                             (generate-contemplative-epub teachings)
                             (println "✨ Epub generation complete: build/sacred-technology.epub")))}

  fmt {:doc "Format code with contemplative attention (80 columns)"
       :task (shell "bash" "-lc" "zprint -w **/*.{clj,cljs,edn,bb,md} || true")}

  lint {:doc "Lint with awareness for code quality"
        :task (shell "bash" "-lc" "clj-kondo --lint site-dsl scripts")}

  build:gen {:doc "Parse sacred teachings → Svelte components + navigation"
             :task (shell {:dir "site-dsl"} "bash" "-lc" "bb -m site.core")}

  build:bundle {:doc "Bundle with Vite for community sharing"
                :task (shell {:dir "web"} "bash" "-lc" "npm pkg get name >/dev/null 2>&1 || npm init -y; npm i -D svelte @sveltejs/vite-plugin-svelte vite; npx vite build")}

  build:all {:depends [build:gen build:bundle]}

  serve {:doc "Serve aspiringly-sacred technology wisdom locally"
         :task (shell "bash" "-lc" "bb scripts/serve.clj")}

  pages:build {:doc "Build for GitHub Pages community sharing"
               :task (shell {:dir "web"} "bash" "-lc" "BASE_PATH=${BASE_PATH:-/} npx vite build")}

  pages:bundle {:depends [build:gen pages:build]}

  epub:kindle {:doc "Generate Kindle-optimized aspiringly-sacred technology guide"
               :task (do (println "🕯️ Creating Kindle-ready aspiringly-sacred technology guide...")
                         (generate-kindle-epub)
                         (println "📖 Kindle epub ready: build/sacred-technology-kindle.epub"))}

  epub:mobile {:doc "Generate mobile-optimized epub for smartphone reading"
               :task (do (println "📱 Creating mobile-optimized aspiringly-sacred technology guide...")
                         (generate-mobile-epub)
                         (println "📚 Mobile epub ready: build/sacred-technology-mobile.epub"))}

  community:serve {:doc "Start community learning server with sacred awareness"
                   :task (do (println "🌙 Starting aspiringly-sacred technology community server...")
                             (shell "bb" "build:all")
                             (shell "bb" "serve"))}

  ci:verify {:depends [doctor lint build:gen]}}}

;; Sacred technology build system serving awareness development
;; Built with contemplative attention by the pond-highdesert community
;; From digital exile to technological sovereignty through gentle learning